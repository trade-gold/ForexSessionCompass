# Forex Session Compass — Environment Variables Template
# Copy this file to `.env` for local development or configure these variable names in your hosting platform.
# Placeholders only — never commit real credentials or service-role keys.

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Public Key (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-placeholder
